# Database (async SQLAlchemy / asyncpg)
DATABASE_URL=postgresql+asyncpg://sumnews:sumnews@localhost:5432/sumnews

# LLM — self-hosted OpenAI-compatible endpoint
LLM_URL=http://localhost:8000/v1
LLM_API_KEY=not-set
LLM_MODEL=local-model
LLM_VERIFY_ENABLED=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=4

# Telegram (Telethon) — mint TELEGRAM_SESSION with: uv run python scripts/tg_login.py
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Watchlist + ingestion
WATCHLIST_PATH=watchlist.yaml
INGEST_INTERVAL_MINUTES=60
INGEST_LOOKBACK_HOURS=48
FEED_FETCH_TIMEOUT_SECONDS=20
